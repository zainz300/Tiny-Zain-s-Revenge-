local function StopJaronaMusic()
    local existing = Workspace:FindFirstChild("Jarona!")
    if existing then
        pcall(function() existing:Destroy() end)
    end
end

local function StartJaronaMusic(targetHumanoid)
    StopJaronaMusic()
    task.spawn(function()
        local s = Instance.new("Sound")
        s.Name = "Jarona!"
        s.Volume = 1.5
        s.Looped = true
        s.Parent = Workspace

        local loaded = false
        if isfile and getcustomasset and isfile("JaronaOST.mp3") then
            local ok = pcall(function()
                s.SoundId = getcustomasset("JaronaOST.mp3")
            end)
            if ok and s.SoundId ~= "" then
                loaded = true
            end
        end

        if not loaded then
            local suc, http = pcall(function()
                return game:HttpGet(JARONA_THEME_URL)
            end)
            if suc and http and writefile and getcustomasset then
                pcall(function()
                    writefile("JaronaOST.mp3", http)
                    s.SoundId = getcustomasset("JaronaOST.mp3")
                    loaded = true
                end)
            end
        end

        if loaded and IsCustomGloveEquipped() and s.Parent == Workspace then
            pcall(function() s:Play() end)
        else
            pcall(function() s:Destroy() end)
            return
        end

        if targetHumanoid then
            targetHumanoid.Died:Once(function()
                if s and s.Parent then
                    pcall(function() s:Destroy() end)
                end
            end)
        end
    end)
end

