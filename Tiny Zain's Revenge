                                        end
                                        TweenService:Create(clonePart, TweenInfo.new(0.5), { Transparency = 1 }):Play()
                                        game:GetService("Debris"):AddItem(clonePart, 0.5)
                                    end
                                end
                            end
                        end)

                        return function()
                            stopFlag = true
                            if h and h.Parent then h:Destroy() end
                            task.delay(0.5, function()
                                if folder and folder.Parent then folder:Destroy() end
                            end)
                        end
                    end

                    -- Blink phase
                    local targetHRP = getClosestHRP(65)
                    if targetHRP then
                        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z))
                        task.wait()
                    end

                    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                        track:Stop()
                    end
                    if animateScript then animateScript.Disabled = true end
                    hrp.Anchored = true

                    local blinkDur = Random.new():NextNumber(0.25, 0.5)
                    local crouchTrack = loadAnim("82327422558552")
                    crouchTrack:Play(0)

                    local blinkHighlight = Instance.new("Highlight")
                    blinkHighlight.FillColor = Color3.new(1, 1, 1)
                    blinkHighlight.FillTransparency = 0
                    blinkHighlight.Parent = currentChar
                    game:GetService("Debris"):AddItem(blinkHighlight, 1)

                    local tween = TweenService:Create(blinkHighlight, TweenInfo.new(blinkDur), {
                        FillTransparency = 1,
                        OutlineTransparency = 1
                    })
                    tween:Play()
                    tween.Completed:Wait()
                    task.wait(0.1)
                    crouchTrack:Stop()
                    hrp.Anchored = false

                    -- Dash phase
                    local dashStart = tick()
                    local rootAttachment = hrp:FindFirstChild("RootAttachment")
                    local lv = nil
                    if rootAttachment then
                        lv = Instance.new("LinearVelocity")
                        lv.Attachment0 = rootAttachment
                        lv.MaxForce = math.huge
                        lv.Parent = hrp
                        game:GetService("Debris"):AddItem(lv, 0.6)
                    end

                    local attackIds = { "103099396948557", "75460316048566", "113281566861349" }
                    local attackTrack = loadAnim(attackIds[math.random(1, #attackIds)])
                    attackTrack:Play(0, 999, 0)

                    local stopImages = spawnAfterImages()

                    task.spawn(function()
                        repeat task.wait() hum:ChangeState(Enum.HumanoidStateType.GettingUp) until tick() - dashStart > 0.6
                    end)

                    task.spawn(function()
                        task.wait(0.6)
                        if attackTrack then attackTrack:Stop() end
                        if stopImages then stopImages() end
                        if animateScript then animateScript.Disabled = false end
                    end)

                    local dashTarget = getClosestHRP(65)
                    if lv then
                        if dashTarget then
                            local dir = (dashTarget.Position - hrp.Position)
                            lv.VectorVelocity = (dir.Magnitude > 0 and dir.Unit or hrp.CFrame.LookVector) * 190
                            task.spawn(function()
                                repeat task.wait() until hum.Health <= 0 or not lv or not lv.Parent
                                    or (hrp.Position - dashTarget.Position).Magnitude < 3 or tick() - dashStart > 0.6
                                if hum.Health <= 0 or not lv or not lv.Parent or tick() - dashStart > 0.6 then return end
                                if lv then lv:Destroy() end
                                flingTarget(dashTarget)
                            end)
                        else
                            lv.VectorVelocity = hrp.CFrame.LookVector * 205
                            task.spawn(function()
                                repeat
                                    task.wait()
                                    dashTarget = getClosestHRP(6)
                                until dashTarget or hum.Health <= 0 or tick() - dashStart > 0.6
                                if hum.Health <= 0 or tick() - dashStart > 0.6 then return end
                                if lv then lv:Destroy() end
                                flingTarget(dashTarget)
                            end)
                        end
                    end

                    repeat task.wait() until tick() - dashStart > 0.6
                    task.wait(0.25)
                end)

                abilityActive = false
                if sillyLoop then
                    pcall(function() task.cancel(sillyLoop) end)
                end
                if parryDashLoop then
                    pcall(function() task.cancel(parryDashLoop) end)
                end
                if not success then
                    warn("Jarona ability error:", err)
                end
            end)

            task.delay(jaronaCooldown, function() canJarona = true end)
        end
    end

    if not movesetInitialized then
        movesetInitialized = true

        ContextActionService:BindActionAtPriority("BypassEAbility", function(_, state)
