local function ClickDetection(Glove)
    local equip = ReplicatedStorage.GloveEquipParticle.Attachment
    local fail = ReplicatedStorage.GloveEquipParticle.Attachment2
    local click = Instance.new("ClickDetector", Glove)
    
    local g = leaderstats:WaitForChild("Glove")
    local unlocked = plr:WaitForChild("_unlockedGloves"):WaitForChild("Marewarder").Value 

    click.MouseClick:Connect(function()
        if unlocked then           
           local sidebarArgs = { [1] = "Inventory" }
           pcall(function()
               ReplicatedStorage.Remotes.SidebarButtonClicked:FireServer(unpack(sidebarArgs))
           end)

           local netArgs = { [1] = "Marewarder" }
           local networkFolder = ReplicatedStorage:FindFirstChild("_NETWORK")
           if networkFolder then
               local rem = networkFolder:FindFirstChild("{388eb21b-b296-4fc6-87dd-5c9884a70c6d}")
               if rem then
                   pcall(function()
                       rem:FireServer(unpack(netArgs))
                   end)
               end
           end

           pcall(function()
               fireclickdetector(Workspace.Lobby["Marewarder"].ClickDetector)
           end)
           
           task.spawn(function()
              task.wait(0.8)
              g.Value = "Tiny Zain's Revenge"
              if plr.Character then
                  SetupMovesetForCharacter(plr.Character)
              end
           end)

           local s = equip:Clone()
           s.Parent = Glove
           for _, v in pairs(s:GetDescendants()) do if v:IsA("ParticleEmitter") then v:Emit(5) end end 
           task.delay(1, function() if s then s:Destroy() end end)
        else
           Workspace.Sounds.Fail:Play()
           local f = fail:Clone()
           f.Parent = Glove
           for _, v in pairs(f:GetDescendants()) do if v:IsA("ParticleEmitter") then v:Emit(5) end end 
           task.delay(1, function() if f then f:Destroy() end end)
        end
    end)
end

task.spawn(function()
    pcall(function()
        local model, glove, stand = CreateGloveModel()
        Customize(model, glove, stand)
        ClickDetection(glove)
    end)
end)
