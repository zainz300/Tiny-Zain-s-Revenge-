        end)

        mobileSlapGUI = CoreGui:FindFirstChild("MobileSlapGUI") or plr:WaitForChild("PlayerGui"):FindFirstChild("MobileSlapGUI")
        if not mobileSlapGUI then
            mobileSlapGUI = Instance.new("ScreenGui")
