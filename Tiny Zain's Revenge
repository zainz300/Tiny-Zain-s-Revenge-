local function IsCustomGloveEquipped()
    local gloveStat = leaderstats:FindFirstChild("Glove")
    return gloveStat and gloveStat.Value == "Tiny Zain's Revenge"
end

local function ApplyCustomToolVisuals(tool)
    if not IsCustomGloveEquipped() then return end

    tool.Name = "Tiny Zain's Revenge"
    tool.ToolTip = "I've suffered for far too long by humanity's wretchedness and cruelty I shall start a new by taking over the world and turning it into my views mwahahahahahahahahahahahahahahahahaha THIS WORLD SHALL KNOW PAIN."

    local glovePart = tool:FindFirstChild("Glove") or tool:FindFirstChildWhichIsA("BasePart")
    
    if glovePart then
        glovePart.Material = Enum.Material.Neon
        glovePart.Color = Color3.fromRGB(255, 255, 0) -- Bright Gold/Yellow
        
        if not glovePart:FindFirstChildOfClass("Highlight") then
            local h = Instance.new("Highlight")
            h.FillColor = Color3.fromRGB(255, 255, 0)
            h.OutlineTransparency = 1
            h.Parent = glovePart
        end
    end
end

local function MonitorCharacter(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            ApplyCustomToolVisuals(child)
        end
    end)
end

if plr.Character then
    MonitorCharacter(plr.Character)
end
plr.CharacterAdded:Connect(MonitorCharacter)

local backpack = plr:WaitForChild("Backpack")
backpack.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        ApplyCustomToolVisuals(child)
    end
end)

local function CreateGloveModel()
    if Workspace:FindFirstChild("nameModel") then
        Workspace:FindFirstChild("nameModel"):Destroy()
    end
    
    local model = Instance.new("Model", Workspace)
    model.Name = "nameModel"

    local glove = Workspace.Lobby.Extended:Clone()
    local stand = Workspace.Lobby.GloveStands.Extended:Clone()

    glove.Parent = model 
    stand.Parent = model

    if glove:FindFirstChildOfClass("ClickDetector") then
        glove:FindFirstChildOfClass("ClickDetector"):Destroy()
    end

    model:PivotTo(CFrame.new(17906.281, -128.5, -3542.889) * CFrame.Angles(math.rad(180), math.rad(90), 0))
    return model, glove, stand
end

